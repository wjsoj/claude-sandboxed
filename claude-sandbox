#!/bin/bash
# Claude Code Sandboxed Launcher
set -e

WORKSPACE="$PWD"
CLAUDE_HOME="$HOME/.claude"
SANDBOX_DIR="$WORKSPACE/.sandbox"

# Parse options
LOAD_SKILLS=0
LOAD_PLUGINS=0
SAVE_SESSION=0
CLAUDE_ARGS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    --with-skills) LOAD_SKILLS=1; shift ;;
    --with-plugins) LOAD_PLUGINS=1; shift ;;
    --full) LOAD_SKILLS=1; LOAD_PLUGINS=1; shift ;;
    --save) SAVE_SESSION=1; shift ;;
    *) CLAUDE_ARGS+=("$1"); shift ;;
  esac
done

# Check bubblewrap
if ! command -v bwrap &>/dev/null; then
  echo "Error: bubblewrap not found" >&2
  exit 1
fi

# Find claude binary
CLAUDE_BIN=$(command -v claude 2>/dev/null)
if [[ -z "$CLAUDE_BIN" ]]; then
  echo "Error: claude not found" >&2
  exit 1
fi
CLAUDE_BIN=$(readlink -f "$CLAUDE_BIN")

# Create sandbox directory structure
mkdir -p "$SANDBOX_DIR"
TEMP_DIR="$SANDBOX_DIR/temp-$$"
mkdir -p "$TEMP_DIR"

# Cleanup function
cleanup() {
  # Save session history if requested
  if [[ $SAVE_SESSION == 1 ]]; then
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    OUTPUT_FILE="$SANDBOX_DIR/output-$TIMESTAMP.jsonl"

    # Find the most recent session file in the temp .claude/projects directory
    LATEST_SESSION=$(find "$TEMP_DIR/.claude/projects" -name "*.jsonl" -type f 2>/dev/null | xargs ls -t 2>/dev/null | head -1)

    if [[ -n "$LATEST_SESSION" && -f "$LATEST_SESSION" ]]; then
      cp "$LATEST_SESSION" "$OUTPUT_FILE"
      echo "Session saved to: $OUTPUT_FILE"
    else
      echo "Warning: No session file found to save"
    fi
  fi

  # Clean up temp directory
  rm -rf "$TEMP_DIR"

  # Clean up any directories created in workspace by Claude Code
  rm -rf "$WORKSPACE/.claude" "$WORKSPACE/.local" "$WORKSPACE/.npm" "$WORKSPACE/.claude.json" 2>/dev/null

  # Clean up old temp directories in .sandbox (keep only output-*.jsonl files)
  if [[ -d "$SANDBOX_DIR" ]]; then
    find "$SANDBOX_DIR" -mindepth 1 -maxdepth 1 -type d -name "temp-*" -exec rm -rf {} + 2>/dev/null
  fi
}

# Copy claude binary to temp
mkdir -p "$TEMP_DIR/.local/bin"
cp "$CLAUDE_BIN" "$TEMP_DIR/.local/bin/claude"
chmod +x "$TEMP_DIR/.local/bin/claude"

# Create isolated .claude directory with minimal config
mkdir -p "$TEMP_DIR/.claude"

# Extract API config from environment variables or settings.json
BASE_URL="${ANTHROPIC_BASE_URL:-}"
AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-}"

# If not in environment, try to read from settings.json
if [[ -z "$BASE_URL" || -z "$AUTH_TOKEN" ]] && [[ -f "$CLAUDE_HOME/settings.json" ]]; then
  if command -v jq &>/dev/null; then
    [[ -z "$BASE_URL" ]] && BASE_URL=$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$CLAUDE_HOME/settings.json")
    [[ -z "$AUTH_TOKEN" ]] && AUTH_TOKEN=$(jq -r '.env.ANTHROPIC_AUTH_TOKEN // empty' "$CLAUDE_HOME/settings.json")
  fi
fi

# Validate that credentials are available
if [[ -z "$AUTH_TOKEN" ]]; then
  echo "Error: ANTHROPIC_AUTH_TOKEN not found in environment or settings.json" >&2
  exit 1
fi

# Create minimal settings.json with only env config
if command -v jq &>/dev/null; then
  jq -n \
    --arg base_url "$BASE_URL" \
    --arg token "$AUTH_TOKEN" \
    '{
      env: {
        ANTHROPIC_BASE_URL: $base_url,
        ANTHROPIC_AUTH_TOKEN: $token
      }
    }' > "$TEMP_DIR/.claude/settings.json"
else
  # Fallback if jq is not available
  cat > "$TEMP_DIR/.claude/settings.json" <<EOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "$BASE_URL",
    "ANTHROPIC_AUTH_TOKEN": "$AUTH_TOKEN"
  }
}
EOF
fi

# Build mounts
MOUNTS=(
  --ro-bind /usr /usr
  --ro-bind /etc /etc
  --symlink /usr/lib /lib
  --symlink /usr/lib64 /lib64
  --symlink /usr/bin /bin
  --dev-bind /dev /dev
  --proc /proc
  --tmpfs /tmp
  --tmpfs /home
  --bind "$WORKSPACE" /workspace
  --ro-bind "$TEMP_DIR/.local" /home/sandbox/.local
  --bind "$TEMP_DIR/.claude" /home/sandbox/.claude
)

# Mount user binaries if they exist
[[ -d "$HOME/.local/bin" ]] && \
  MOUNTS+=(--ro-bind "$HOME/.local/bin" /usr/local/bin)

[[ -d "$HOME/.cargo/bin" ]] && \
  MOUNTS+=(--ro-bind "$HOME/.cargo/bin" /home/sandbox/.cargo/bin)

# Share network namespace for API access
[[ -d /run/systemd/resolve ]] && \
  MOUNTS+=(--ro-bind /run/systemd/resolve /run/systemd/resolve)

# Optional mounts
[[ $LOAD_SKILLS == 1 && -d "$CLAUDE_HOME/skills" ]] && \
  MOUNTS+=(--ro-bind "$CLAUDE_HOME/skills" /home/sandbox/.claude/skills)

[[ $LOAD_PLUGINS == 1 && -d "$CLAUDE_HOME/plugins" ]] && \
  MOUNTS+=(--ro-bind "$CLAUDE_HOME/plugins" /home/sandbox/.claude/plugins)

# Launch
bwrap \
  "${MOUNTS[@]}" \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --new-session \
  --die-with-parent \
  --chdir /workspace \
  --setenv HOME /home/sandbox \
  --setenv PATH "/home/sandbox/.local/bin:/usr/local/bin:/home/sandbox/.cargo/bin:/usr/bin:/bin" \
  --setenv ANTHROPIC_BASE_URL "$BASE_URL" \
  --setenv ANTHROPIC_AUTH_TOKEN "$AUTH_TOKEN" \
  --unsetenv CLAUDECODE \
  /home/sandbox/.local/bin/claude "${CLAUDE_ARGS[@]}"

# Capture exit code
EXIT_CODE=$?

# Trigger cleanup manually
cleanup

# Exit with the same code as claude
exit $EXIT_CODE
